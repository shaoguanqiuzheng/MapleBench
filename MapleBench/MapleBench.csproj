<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- MapleLib is a WinForms/WPF-flavoured net10.0-windows library; matching the
         desktop framework keeps System.Drawing.Bitmap available for canvas rendering. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyTitle>MapleBench</AssemblyTitle>
    <Description>Windows WZ editor and dependency-aware MapleStory client importer with visual previews and verified saves</Description>
    <Product>MapleBench</Product>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <RootNamespace>MapleBench</RootNamespace>

    <!-- Gives the exe, taskbar and Alt-Tab a real icon instead of the
         generic .NET one. DesktopShell loads the same file at runtime for
         the window itself. -->
    <ApplicationIcon>MapleBench.ico</ApplicationIcon>

    <!-- ManifestEmbeddedFileProvider (single-file wwwroot serving) needs the
         generated manifest that names every embedded resource. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MapleBench.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dependencies\MapleLib\MapleLib.csproj" />
  </ItemGroup>

  <!-- A single-file publish must be the exe alone. The Web SDK still copies
       wwwroot loose next to it (the embedded copies are what is served), and
       it also emits web.config, the static-asset manifest and the WebView2
       XML documentation. Prune all of them after Publish so the output is one
       file. -->
  <Target Name="PruneSingleFilePublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneDirs Include="$(PublishDir)wwwroot" />
      <_PruneFiles Include="$(PublishDir)web.config" />
      <_PruneFiles Include="$(PublishDir)*.xml" />
      <_PruneFiles Include="$(PublishDir)*.staticwebassets.endpoints.json" />
    </ItemGroup>
    <RemoveDir Directories="@(_PruneDirs)" Condition="Exists('%(Identity)')" />
    <Delete Files="@(_PruneFiles)" Condition="Exists('%(Identity)')" />
  </Target>

  <ItemGroup>
    <!-- Hosts the UI in a real window instead of a browser tab. The Edge
         runtime it needs ships with Windows 10/11; DesktopShell falls back to
         the browser when it is missing. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <!-- The WebView2 package hands every .NET 5+ project three assemblies: Core,
       WinForms and Wpf. We host in WinForms and never touch the WPF control,
       but Microsoft.Web.WebView2.Wpf.dll references WindowsBase 5.0.0.0 (WPF's).
       Since MapleLib stopped setting UseWPF, the only WindowsBase in the graph
       is the 4.0.0.0 facade in Microsoft.NETCore.App.Ref, and RAR reports the
       unresolvable conflict as MSB3277 on every build. Dropping the reference we
       do not use is the fix; adding WPF back to satisfy a DLL nothing calls
       would cost 32 MB to silence one warning.

       This has to be a target rather than a plain ItemGroup: NuGet imports the
       package's .targets after the project body, so the Reference does not exist
       yet at evaluation time. -->
  <Target Name="DropUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WebView2WpfReference Include="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_WebView2WpfReference)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The host serves wwwroot from AppContext.BaseDirectory so the built
         output runs standalone; the Web SDK does not copy it there by default. -->
    <!-- Development builds copy wwwroot next to the exe (physical files served
         by UseStaticFiles). Single-file publish embeds the UI instead: the
         Web SDK's own wwwroot glob marks these Content items
         ExcludeFromSingleFile=true, so a single-file build would otherwise
         ship 150 loose files beside the exe and serve an empty window. The
         EmbeddedResource glob below is what actually carries the UI into the
         exe; Program.cs swaps in a ManifestEmbeddedFileProvider over
         "MapleBench.wwwroot" when no physical wwwroot exists. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="wwwroot\**"
                      Exclude="wwwroot\**\*.br;wwwroot\**\*.gz;wwwroot\**\*.map" />
  </ItemGroup>

</Project>
